nd":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Loading data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vZSUKYub59"}],"identifier":"loading-data","label":"Loading data","html_id":"loading-data","implicit":true,"key":"T7kvgqs38y"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As always, we need to load the data. For simplicity and to demonstrate the capacity of particles sliding on the wall, I am going to use the stream function of an ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Fjz1oM01Fj"},{"type":"inlineMath","value":"f","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>f</mi></mrow><annotation encoding=\"application/x-tex\">f</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span></span></span></span>","key":"XxiJp0cGIS"},{"type":"text","value":"-plane gyre. You can think of this example as a zonal overturning cell in a meridional channel.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EiBx74ozpn"}],"key":"vWBVifecd6"}],"key":"XR8pINetDi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def streamfunction(x, z):\n    tempz = -z / 500 - 1\n    return np.cos(np.pi * x / 2) * np.cos(np.pi * tempz / 2)","key":"GY0LyraCo8"},{"type":"outputs","id":"Q4zjfO41z0EKPKxtsPA70","children":[],"key":"NtE9FgCsV2"}],"key":"CFdGlO2WXU"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"N = 100\nM = 50\nx = np.linspace(-1, 1, N + 1)\ny = np.linspace(-0.1, 0.1, 2)\nzl = np.linspace(0, -1000, M)\nzp1 = np.append(zl, -1001)\nxg, yg = np.meshgrid(x, y)\nxv = 0.5 * (xg[:, 1:] + xg[:, :-1])\nyv = 0.5 * (yg[:, 1:] + yg[:, :-1])\nxu = 0.5 * (xg[1:] + xg[:-1])\nyu = 0.5 * (yg[1:] + yg[:-1])\n\nxc = 0.5 * (xv[1:] + xv[:-1])\nyc = 0.5 * (yv[1:] + yv[:-1])\n\ntempx, tempz = np.meshgrid(x, zl)\nstrmf = streamfunction(tempx, tempz).reshape(len(zl), 1, -1)\nz = 0.5 * (zp1[1:] + zp1[:-1])\nzl = zp1[:-1]\ndrf = np.abs(np.diff(zp1))","visibility":"hide","key":"kHHpD5TDDW"},{"type":"outputs","id":"IN0ZP-nnC6pUezb1z7weJ","children":[],"visibility":"show","key":"J1tuQfklY5"}],"visibility":"show","key":"dYAM5bir8n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"u = np.zeros((M, 1, N + 1), float)\nu[:-1] = np.diff(strmf, axis=0)\nw = np.diff(strmf, axis=-1)\nv = np.zeros((M, 2, N), float)","key":"aKfuxHI8xe"},{"type":"outputs","id":"VZ9SX472ccMhamrfZYnJ4","children":[],"key":"WdS7xRiLiw"}],"key":"VffARlbgF2"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"stream = np.zeros((M, 2, N + 1))\nstream[:] = strmf","visibility":"hide","key":"HMzTkrblka"},{"type":"outputs","id":"l4CInS9bX5Y-JPu00XsFQ","children":[],"visibility":"show","key":"NSxV0Rezan"}],"visibility":"show","key":"CnQi77J63P"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"ds = xr.Dataset(\n    coords=dict(\n        XC=([\"Y\", \"X\"], xc),\n        YC=([\"Y\", \"X\"], yc),\n        XG=([\"Yp1\", \"Xp1\"], xg),\n        YG=([\"Yp1\", \"Xp1\"], yg),\n        Zl=([\"Zl\"], zl),\n        Z=([\"Z\"], z),\n        drF=([\"Z\"], drf),\n        rA=([\"Y\", \"X\"], np.ones_like(xc, float)),\n    ),\n    d