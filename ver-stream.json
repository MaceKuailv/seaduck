book-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Loading data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zgyNLdysQ4"}],"identifier":"loading-data","label":"Loading data","html_id":"loading-data","implicit":true,"key":"hgtcOCmhBb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As always, we need to load the data. For simplicity and to demonstrate the capacity of particles sliding on the wall, I am going to use the stream function of an ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ANu1TrJSgb"},{"type":"inlineMath","value":"f","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>f</mi></mrow><annotation encoding=\"application/x-tex\">f</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span></span></span></span>","key":"aAftIh8DtG"},{"type":"text","value":"-plane gyre. You can think of this example as a zonal overturning cell in a meridional channel.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gflHD3zOgv"}],"key":"tP4sEe1Q2U"}],"key":"PwTR5dHoYz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def streamfunction(x, z):\n    tempz = -z / 500 - 1\n    return np.cos(np.pi * x / 2) * np.cos(np.pi * tempz / 2)","key":"qPntBV6oWk"},{"type":"outputs","id":"c0qnSa16VMIaYNSNQnMyG","children":[],"key":"SUON1nJXf6"}],"key":"c3Rh1X09z5"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"N = 100\nM = 50\nx = np.linspace(-1, 1, N + 1)\ny = np.linspace(-0.1, 0.1, 2)\nzl = np.linspace(0, -1000, M)\nzp1 = np.append(zl, -1001)\nxg, yg = np.meshgrid(x, y)\nxv = 0.5 * (xg[:, 1:] + xg[:, :-1])\nyv = 0.5 * (yg[:, 1:] + yg[:, :-1])\nxu = 0.5 * (xg[1:] + xg[:-1])\nyu = 0.5 * (yg[1:] + yg[:-1])\n\nxc = 0.5 * (xv[1:] + xv[:-1])\nyc = 0.5 * (yv[1:] + yv[:-1])\n\ntempx, tempz = np.meshgrid(x, zl)\nstrmf = streamfunction(tempx, tempz).reshape(len(zl), 1, -1)\nz = 0.5 * (zp1[1:] + zp1[:-1])\nzl = zp1[:-1]\ndrf = np.abs(np.diff(zp1))","visibility":"hide","key":"Ai9V8kFbkU"},{"type":"outputs","id":"jA8hW9bYOTIMq7s5cG2_I","children":[],"visibility":"show","key":"mdGfWstjsD"}],"visibility":"show","key":"pK2Iqg3SgH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"u = np.zeros((M, 1, N + 1), float)\nu[:-1] = np.diff(strmf, axis=0)\nw = np.diff(strmf, axis=-1)\nv = np.zeros((M, 2, N), float)","key":"FZKX9GxqaE"},{"type":"outputs","id":"3Riypfx21QxsjUX61fzNa","children":[],"key":"urTf8nFL7g"}],"key":"N0s7zT3O8I"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"stream = np.zeros((M, 2, N + 1))\nstream[:] = strmf","visibility":"hide","key":"N1WMph4dL0"},{"type":"outputs","id":"iru9JdnkAigLySFHMa64t","children":[],"visibility":"show","key":"Zc4h4EMvFo"}],"visibility":"show","key":"ELz9HiwT7M"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"ds = xr.Dataset(\n    coords=dict(\n        XC=([\"Y\", \"X\"], xc),\n        YC=([\"Y\", \"X\"], yc),\n        XG=([\"Yp1\", \"Xp1\"], xg),\n        YG=([\"Yp1\", \"Xp1\"], yg),\n        Zl=([\"Zl\"], zl),\n        Z=([\"Z\"], z),\n        drF=([\"Z\"], drf),\n        rA=([\"Y\", \"X\"], np.ones_like(xc, float)),\n    ),\n    data_vars=