ine":104,"column":1}},"key":"Ai1WxRdNVd"}],"key":"VOSPnG552U"}],"key":"v8yg80Lf7w"},{"type":"block","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"We are going to follow a cold puff of fresh water near the Greenland shelf. Since we have ","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"aZlS4izE1J"},{"type":"inlineCode","value":"OceanSpy","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"Js4Lg5onJk"},{"type":"text","value":" installed here at SciServer, let me quickly show you how to make a vertical section of this region. (It really takes no effort at all!)","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"BdwmtdG9Vi"}],"key":"r5LVkPjrQW"}],"key":"irEBBazCdx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"od_surv = od.subsample.survey_stations(\n    Xsurv=[-22.0, -19.0], Ysurv=[71.0, 71.0], delta=1\n)\nod_surv._ds = od_surv._ds.isel(time=0)\nod_surv.plot.vertical_section(varName=\"Temp\", contourName=\"Sigma0\")\nplt.ylim([-750, 0])\nplt.show()","key":"bEf5yfUztZ"},{"type":"outputs","id":"gf15KFSQtarwUbSeCEo1E","children":[],"key":"s6WjBmN4Ea"}],"key":"GuwhCA9GtM"},{"type":"block","children":[{"type":"image","url":"/seaduck//build/c3fb0f464529ef92d5c1b87e2e6a2ced.png","alt":"png","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"xvYckZTZgn","urlSource":"https://github.com/MaceKuailv/seaduck_sciserver_notebook/blob/master/IGPwinter_files/IGPwinter_19_1.png?raw=true"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"strong","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Fig.2","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"alXjBRgNCK"}],"key":"biXz6ZDrtP"},{"type":"text","value":" Vertical section at 71N. This vertical section goes a little further east than the initial particle positions to include the shelf break. Colors denotes the potential temperature, while the contours are the potential density anomaly calculated using OceanSpy (with the equation of state the model used).","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"KBtR0hlePG"}],"key":"GpG6SOJZiW"}],"key":"bzFxop2PZg"},{"type":"block","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"Since we are in an open domain (in all three dimensions), given long enough time, some particles will leave the domain. This will jeopardise the entire simulation!  We can define a callback function to stop that from happening.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"XqsGj3Whtt"}],"key":"xbUN0Dqsrs"},{"type":"paragraph","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"If provided, the function will be called every time particles cross walls. It can be used to manipulate the particles and catch the out-of-domain issue. But here we just use it as a stop/continue criterion.","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"RHg5idbLr9"}],"key":"zlib2tuJg5"}],"key":"UpQKYdb5aA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def continue_criterion(pt):\n    x_ = np.logical_and(pt.lon < -10, pt.lon > -35)\n    y_ = np.logical_and(pt.lat < 72, pt.lat > 65)\n    z_ = pt.dep > -750\n    return np.logical_and(np.logical_and(x_, y_), z_)","key":"eQgKFtAR1z"},{"type":"outputs","id":"O