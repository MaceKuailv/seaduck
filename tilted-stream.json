/blob/main/docs/logo.png?raw=true\",\n    known_hash=\"bed53271c0356006eb02751040b7a10536b853872de1c728106ee56227b7c0f8\",\n)\nimage = Image.open(file_path)\nrgb = np.asarray(image)\n\nbins = 1024 // n\nparticle_color = rgb[::-bins, ::bins].reshape(len(x), 3) / 255\n\n\ndef plot_particle3d(pt, c=particle_color, s=8):\n    fig = plt.figure(figsize=(15, 5))\n    ax1 = plt.subplot(1, 3, 1)\n    ax1.scatter(pt.lat, pt.dep, c=c, s=s)\n    ax1.set_ylabel(\"z\")\n    ax1.set_xlabel(\"y\")\n    ax1.set_title(\"Y-Z plane\")\n\n    ax2 = plt.subplot(1, 3, 2)\n    ax2.scatter(pt.lon, pt.dep, c=c, s=s)\n    ax2.set_ylabel(\"z\")\n    ax2.set_xlabel(\"x\")\n    ax2.set_title(\"X-Z plane\")\n\n    ax3 = plt.subplot(1, 3, 3)\n    ax3.scatter(pt.lon, pt.lat, c=c, s=s)\n    ax3.set_ylabel(\"y\")\n    ax3.set_xlabel(\"x\")\n    ax3.set_title(\"X-Y plane\")\n\n    return fig","visibility":"hide","key":"pswkvtEYOQ"},{"type":"outputs","id":"v-rqv5SlIuOg1JpH9Bjmy","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"Downloading data from 'https://github.com/MaceKuailv/seaduck/blob/main/docs/logo.png?raw=true' to file '/home/runner/.cache/pooch/f4725c9d21fcfd35d4084e061f68e22e-logo.png'.\n"},"key":"gyaf6VUwtG"}],"visibility":"show","key":"x5opc0tlJj"}],"visibility":"show","key":"rtsPedUOmH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Run the test","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oMHHArMMa2"}],"identifier":"run-the-test","label":"Run the test","html_id":"run-the-test","implicit":true,"key":"W7xskMsMcn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let’s take a look at the initial condition:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"