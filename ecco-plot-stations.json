,"key":"fka8lyLWat"},{"type":"outputs","id":"lhvarYxsW8c2lL-CLuBrz","children":[],"key":"cCqGoRUnx8"}],"key":"dXzF83DqA3"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Define coordinates for interpolation from the Poseidon-viewer (or enter them manually):","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"WX4ztntPb5"}],"key":"vrke4vAh5n"}],"key":"rzmyKLlLEB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ps = [\n    {\"type\": \"Point\", \"coordinates\": [-57.710530333876235, 33.062070736515295]},\n    {\"type\": \"Point\", \"coordinates\": [-89.55599488497559, 25.453020491528747]},\n    {\"type\": \"Point\", \"coordinates\": [-74.70605786848537, 13.952759739624767]},\n    {\"type\": \"Point\", \"coordinates\": [-59.06355926811892, 21.999755420813273]},\n    {\"type\": \"Point\", \"coordinates\": [-41.69588507736159, 22.43955659234939]},\n    {\"type\": \"Point\", \"coordinates\": [-45.113026771172656, 14.563543828761837]},\n    {\"type\": \"Point\", \"coordinates\": [-26.081872200732885, 6.414099524482438]},\n    {\"type\": \"Point\", \"coordinates\": [-17.396102656758963, -4.381322875209875]},\n    {\"type\": \"Point\", \"coordinates\": [-26.702603318403906, -7.125636489486197]},\n    {\"type\": \"Point\", \"coordinates\": [-32.51011235240231, -22.847802807885373]},\n]\nlons, lats = ospy.utils.viewer_to_range(ps)\nNstations = len(lons)","key":"t0rNA5iqoF"},{"type":"outputs","id":"CYNypgolUh-fjgGpNeXFB","children":[],"key":"bgv5cysL6y"}],"key":"XwNmoAsGnh"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"inlineCode","value":"seaduck.OceInterp","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"lQUJYj1ISP"},{"type":"text","value":" interpolates the temperature and salinity to the specified coordinates.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"vksQor41B9"}],"identifier":"seaduck-oceinterp-interpolates-the-temperature-and-salinity-to-the-specified-coordinates","label":"seaduck.OceInterp interpolates the temperature and salinity to the specified coordinates.","html_id":"seaduck-oceinterp-interpolates-the-temperature-and-salinity-to-the-specified-coordinates","implicit":true,"key":"Yf2UPtREHh"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"This process makes synthetic hydrographic profiles from ECCO. Compute the potential density anomaly from the T/S data too.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"ksWKdkCxPG"}],"key":"GDr5HY872w"}],"key":"PhmQOpKhsH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tub = sd.OceData(od._ds)\ntimes = sd.utils.convert_time(this_time)\nNtimes = times.size\n\ndepths = tub.Z.ravel()\nNdepths = len(depths)\n\nsd_lons, sd_times, sd_depths = np.meshgrid(lons, times, depths, indexing=\"ij\")\nsd_lats, _, _ = np.meshgrid(lats, times, depths, indexing=\"ij\")\nsd_lons = np.ravel(sd_lons)\nsd_lats = np.ravel(sd_lats)\nsd_times = np.ravel(sd_times)\nsd_depths = np.ravel(sd_depths)\n\n[sd_Temp, sd_S] = np.array(\n    sd.OceInterp(tub, varList, sd_lons, sd_lats, sd_depths, sd_times)\n)\nsd_depths2 = sd_depths.reshape(Nstations, Ntimes, Ndepths).squeeze()\nsd_S = sd_S.reshape(Nstations, Ntimes, Ndepths).squeeze()\nsd_Temp = sd_Temp.reshape(Nstations, Ntimes, Ndepths).squeeze()\n\nsd_sigma0 = ospy.utils.densjmd95(sd_S, sd_Temp, 0) - 1000.0","key":"lKcQdMzjco"},{"type":"outputs","id":"G5ur0ZpEHPzL1IPjZ0l02","children":[],"key":"uEwvJvhz52"}],"key":"rn7OPee19N"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Plot station locations:","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"mB4iqtwKn0"}],"identifier":"plot-station-locations","label":"Plot station locations:","html_id":"plot-station-locations","implicit":true,"key":"rrVlp9RGfF"}],"key":"lT8DlRautB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cut_od = od.subsample.cutout(\n    XRange=[min(lons) - 10, max(lons) + 10], YRange=[min(lats) - 5, max(lats) + 5]\n)\nfig = plt.figure(figsize=(12, 5))\nax = cut_od.plot.horizontal_section(varName=\"Depth\", cmap=\"Greys_r\")\ncolors = [\n    \"r\",\n    \"b\",\n    \"k\",\n    \"orange\",\n    \"darkgreen\",\n    \"m\",\n    \"yellow\",\n    \"c\",\n    \"indigo\",\n    \"magenta\",\n    \"green\",\n]\nlegestations_ds = np.arange(Nstations)\nfor i in range(Nstations):\n    plt.plot(\n        lons[i],\n        lats[i],\n        \"o\",\n        color=colors[i],\n        label=\"station \" + str(legestations_ds[i]),\n    )\nplt.legend()\nplt.show()","key":"Iljw8xc3LY"},{"type":"outputs","id":"u2GBuCW8SJpg9W4cG8hlA","children":[],"key":"HjQOmGKpZ7"}],"key":"faP5RLhGfh"},{"type":"block","children":[{"type":"image","url":"/build/304fbe4d321f1b73bcd6a1c136b282d8.png","alt":"png","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"EXjeq0LuAb","urlSource":"https://github.com/MaceKuailv/seaduck_sciserver_notebook/blob/master/ECCO_plot_stations_files/ECCO_plot_stations_9_1.png?raw=true"},{"type":"heading","depth":2,"position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Plot vertical T/S station profiles:","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"PbBXi4IuKI"}],"identifier":"plot-vertical-t-s-station-profiles","label":"Plot vertical T/S station profiles:","html_id":"plot-vertical-t-s-station-profiles","implicit":true,"key":"pvCCdqVvQ4"}],"key":"r6mvgIyfkq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i in range(Nstations):\n    plt.subplot(1, 3, 1)\n    plt.plot(\n        sd_Temp[i, :],\n        depths,\n        \"o\",\n        color=colors[i],\n        label=\"station \" + str(legestations_ds[i]),\n    )\n    plt.xlabel(\"Temperature [oC]\")\n    plt.ylabel(\"Depth [m]\")\n    plt.grid()\n\n    plt.subplot(1, 3, 2)\n    plt.plot(\n        sd_S[i, :],\n        depths,\n        \"o\",\n        color=colors[i],\n        label=\"station \" + str(legestations_ds[i]),\n    )\n    plt.xlabel(\"Salinity [g/kg]\")\n    plt.grid()\n\n    plt.subplot(1, 3, 3)\n    plt.plot(\n        sd_sigma0[i, :],\n        depths,\n        \"o\",\n        color=colors[i],\n        label=\"station \" + str(legestations_ds[i]),\n    )\n    plt.xlabel(\"Density anomaly [kg/m^3]\")\n    plt.grid()\n\nplt.subplot(1, 3, 1)\nplt.xlabel(\"Temperature [oC]\")\nplt.ylabel(\"Depth [m]\")\nplt.grid()\n\nplt.subplot(1, 3, 2)\nplt.xlabel(\"Salinity [g/kg]\")\nplt.grid()\n\nplt.subplot(1, 3, 3)\nplt.xlabel(\"Density anomaly [kg/m^3]\")\nplt.grid()\nplt.legend()\n\nplt.show()","key":"cBWy9ccMO3"},{"type":"outputs","id":"9BWWV8GFNcOOzWdM8dHcU","children":[],"key":"ChileiJ9so"}],"key":"L3YPH6o1mG"},{"type":"block","children":[{"type":"image","url":"/build/8430cb48376ced931de6aec80cdb9fed.png","alt":"png","position":{"start":{"line":194,"column":1},"end":{"line":194,"column":1}},"key":"z0Hgt5vqNZ","urlSource":"https://github.com/MaceKuailv/seaduck_sciserver_notebook/blob/master/ECCO_plot_stations_files/ECCO_plot_stations_11_0.png?raw=true"},{"type":"heading","depth":2,"position":{"start":{"line":196,"column":1},"end":{"line":196,"column":1}},"children":[{"type":"text","value":"Plot T/S diagram.","position":{"start":{"line":196,"column":1},"end":{"line":196,"column":1}},"key":"A3ZF2F5Hj9"}],"identifier":"plot-t-s-diagram","label":"Plot T/S di