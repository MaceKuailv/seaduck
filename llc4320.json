\"LLC4320lats.npy\")\nspds = np.load(\"LLC4320spds.npy\")","position":{"start":{"line":145,"column":1},"end":{"line":149,"column":1}},"key":"XThamJp6wQ"},{"type":"heading","depth":2,"position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"text","value":"Plotting Preparation","position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"key":"iHFxF8UjGt"}],"identifier":"plotting-preparation","label":"Plotting Preparation","html_id":"plotting-preparation","implicit":true,"key":"mWdBwh1o35"},{"type":"paragraph","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"qVS3mnlFWU"},{"type":"link","url":"https://www.ncei.noaa.gov/products/etopo-global-relief-model","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"ETOPO","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"ae7PeGqWk5"}],"urlSource":"https://www.ncei.noaa.gov/products/etopo-global-relief-model","key":"Kmfp1XiOsJ"},{"type":"text","value":" topography dataset is also accessible on SciServer using ","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"nnuGNLbTGE"},{"type":"inlineCode","value":"OceanSpy","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"GtS8XN6Vol"},{"type":"text","value":". This will give us absolutely beautiful plots.","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"I50Usxbf7T"}],"key":"VisH4TFOPj"}],"key":"yn85yhZN1d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"etopo = ospy.open_oceandataset.from_catalog(\"ETOPO\")","key":"jrpoHbjv61"},{"type":"outputs","id":"4tDEUxSfmWEsCWEUh46Xs","children":[],"key":"HWuAfo6JMp"}],"key":"B5483I2hxd"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"For this notebook, we only need the land, because there is already so much going on in the water. So clip the ","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"WnnnkXaY3T"},{"type":"inlineCode","value":"etopo","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"k1YPn1bgWb"},{"type":"text","value":" data.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"djYnehqjas"}],"key":"X6jLVCewrU"}],"key":"t4H5n6JEaQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"etopo = etopo._ds.where(etopo._ds.Depth > 0)","key":"t3mMF2FZYG"},{"type":"outputs","id":"enPO6Ik9TDw0hxOqxQN7_","children":[],"key":"U1Uy6ytsoe"}],"key":"TjPAEazc3e"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"Here is the function for plotting. The lines will be colored with speed. This part is going to take some time, but I hope you think it’s worth the wait.","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"qxqoAVrCQz"}],"key":"TnNMrjads6"}],"key":"POB8DJoznn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def pretty_stream_plot(\n    lats,\n    lons,\n    spds,\n    projection,\n    particle_bins=1,\n    bins=5,\n    north=1000,\n    south=-1000,\n    plot_lines=True,\n    save_as=None,\n):\n    plt.figure(figsize=(16, 16))\n    axs = plt.axes(projection=projection)\n    axs.set_extent([-1e4, 1e4, south, north], crs=ccrs.PlateCarree())\n    plt.tight_layout()\n    axs.pcolormesh(\n        etopo.X[::bins],\n        etopo.Y[::bins],\n        etopo.Depth[::bins, ::bins],\n        transform=ccrs.PlateCarree(),\n        cmap=\"bone\",\n        vmin=-3000,\n        vmax=4500,\n        zorder=20,\n        rasterized = True,\n    )\n    axs.set_facecolor(\"lightsteelblue\")\n    print(\"finished making the map\")\n    if not plot_lines:\n        print(\"skipping the lines\")\n        return\n    # To speed up the computation, we transform the\n    # latlon outside the for plotting for-loop.\n    xx, yy, _ = projection.transform_points(ccrs.PlateCarree(), lons, lats).T\n\n    xx = xx.T\n    yy = yy.T\n\n    for i in tqdm(range(0, lons.shape[1], particle_bins)):\n        y = yy.T[i][1:]\n        x = xx.T[i][1:]\n        if np.max(x) - np.min(x) > 300:\n            x[x < 0] += 360\n        dydx = (0.5 * (spds.T[i][:-1] + spds.T[i][1:]))[1:]  # first derivative\n\n        # Create a set of line segments so that we can color them individually\n        # This creates the points as a N x 1 x 2 array so that we can stack points\n        # together easily to get the segments. The segments array for line collection\n        # needs to be (numlines) x (points per line) x 2 (for x and y)\n        points = np.array([x, y]).T.reshape(-1, 1, 2)\n\n        segments = np.concatenate([points[:-1], points[1:]], axis=1)\n\n        # Create a continuous norm to map from data points to colors\n        norm = plt.Normalize(0, 1.0)\n        lc = LineCollection(segments, cmap=\"GnBu_r\", norm=norm)\n        # Set the values used for colormapping\n        lc.set_array(dydx)\n        lc.set_linewidth(0.3)\n        lc.set_rasterized(True)\n        axs.add_collection(lc)\n\n    if save_as is not None:\n        plt.savefig(save_as,dpi = 300)","key":"Xggq0r2LqS"},{"type":"outputs","id":"--_E9S_761NVmgxdxulLx","children":[],"key":"WugOicLKAl"}],"key":"oqrAuypA96"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"children":[{"type":"text","value":"Voila!","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},