0GJXR8f"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"For this notebook, we only need the land, because there is already so much going on in the water. So clip the ","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"BRiq5EuZ8E"},{"type":"inlineCode","value":"etopo","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"nK8ChtkwbM"},{"type":"text","value":" data.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"DxzNVz00K0"}],"key":"loAAhjeYVT"}],"key":"gQ29k5cAbZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"etopo = etopo._ds.where(etopo._ds.Depth > 0)","key":"UyMM20vMoM"},{"type":"outputs","id":"2lfzmMQAP6nPnfwn9YzJq","children":[],"key":"EayqGgYWnv"}],"key":"lzqcrkZTTX"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"Here is the function for plotting. The lines will be colored with speed. This part is going to take some time, but I hope you think it’s worth the wait.","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"rjGQtTmOfQ"}],"key":"qkD3iMVMCE"}],"key":"OKMizrsxPc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def pretty_stream_plot(\n    lats,\n    lons,\n    spds,\n    projection,\n    particle_bins=1,\n    bins=5,\n    north=1000,\n    south=-1000,\n    plot_lines=True,\n    save_as=None,\n):\n    plt.figure(figsize=(16, 16))\n    axs = plt.axes(projection=projection)\n    axs.set_extent([-1e4, 1e4, south, north], crs=ccrs.PlateCarree())\n    plt.tight_layout()\n    axs.pcolormesh(\n        etopo.X[::bins],\n        etopo.Y[::bins],\n        etopo.Depth[::bins, ::bins],\n        transform=ccrs.PlateCarree(),\n        cmap=\"bone\",\n        vmin=-3000,\n        vmax=4500,\n        zorder=20,\n        rasterized = True,\n    )\n    axs.set_facecolor(\"lightsteelblue\")\n    print(\"finished making the map\")\n    if not plot_lines:\n        print(\"skipping the lines\")\n        return\n    # To speed up the computation, we transform the\n    # latlon outside the for plotting for-loop.\n    xx, yy, _ = projection.transform_points(ccrs.PlateCarree(), lons, lats).T\n\n    xx = xx.T\n    yy = yy.T\n\n    for i in tqdm(range(0, lons.shape[1], particle_bins)):\n        y = yy.T[i][1:]\n        x = xx.T[i][1:]\n        if np.max(x) - np.min(x) > 300:\n            x[x < 0] += 360\n        dydx = (0.5 * (spds.T[i][:-1] + spds.T[i][1:]))[1:]  # first derivative\n\n        # Create a set of line segments so that we can color them individually\n        # This creates the points as a N x 1 x 2 array so that we can stack points\n        # together easily to get the segments. The segments array for line collection\n        # needs to be (numlines) x (points per line) x 2 (for x and y)\n        points = np.array([x, y]).T.reshape(-1, 1, 2)\n\n        segments = np.concatenate([points[:-1], points[1:]], axis=1)\n\n        # Create a continuous norm to map from data points to colors\n        norm = plt.Normalize(0, 1.0)\n        lc = LineCollection(segments, cmap=\"GnBu_r\", norm=norm)\n        # Set the values used for colormapping\n        lc.set_array(dydx)\n        lc.set_linewidth(0.3)\n        lc.set_rasterized(True)\n        axs.add_collection(lc)\n\n    if save_as is not None:\n        plt.savefig(save_as,dpi = 300)","key":"YwxYNNNDd3"},{"type":"outputs","id":"0zDzkIN2U3CA44uiuLdTL","children":[],"key":"GcBxdAQ2tl"}],"key":"Brph72IAN1"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"children":[{"type":"text","value":"Voila!","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"key":"n1POkf5a7B"}],"identifier":"voila","label":"Voila!","html_id":"voila","implicit":true,"key":"Gav1UZUZfo"},{"type":"heading","depth":3,"position":{"start":{"line":237,"column":1},"end":{"line":237,"column":1}},"children":[{"type":"text","value":"Looking from the Arctic","position":{"start":{"line":237,"column":1},"end":{"line":237,"column":1}},"key":"epeBpSh3Ga"}],"identifier":"looking-from-the-arctic","label":"Looking from the Arctic","html_id":"looking-from-the-arctic","implicit":true,"key":"gtezdISqaw"}],"key":"Y3bpgL1g2A"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"north_projection = ccrs.NorthPolarStereo(central_longitude=38.0)\npretty_stream_plot(\n    lats,\n    lons,\n    spds,\n    north_projection,\n    south=6.5,\n    save_as=\"LLC4320_files/LLC4320_29_2.png\",\n)\nplt.show()","key":"yr6hhyzpdW"},{"type":"outputs","id":"23WxW-DSLJhnZq8vmbtWJ","children":[],"key":"I2qO6Xhy8T"}],"key":"S4mafT1rog"},{"type":"block","children":[{"type":"image","url":"/seaduck//build/undefined","alt":"png","position":{"start":{"line":251,"column":1},"end":{"line":251,"column":1}},"key":"kmHwLwhQio","urlSource":"https://github.com/MaceKuailv/seaduck_sciserver_notebook/blob/master/LLC4320_files/LLC4320_29_2.png?raw=true"},{"type":"paragraph","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"children":[{"type":"strong","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"children":[{"type":"text","value":"Fig.1","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"key":"PZLJjBiSJs"}],"key":"XM5l8QHpku"},{"type":"text","value":" Streamlines of 150,000 particles released at 00:00 Apr 25, 2012 in LLC4320 simulated for 30 days. The color shading shows the current speed. This is looking from the North Pole.","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"key":"tXSa5o0Piq"}],"key":"M0myORh